{
  "name": "gateway",
  "version": "1.0.0",
  "private": true,
  "description": "API gateway for resume-builder microservices",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
