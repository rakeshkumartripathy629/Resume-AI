# ══════════════════════════════════════════════════════════════════════
# Railway Backend Environment Variables
# Set these in Railway Dashboard → Variables tab
# All 6 services (gateway + 5 microservices) run in ONE Railway service
# ══════════════════════════════════════════════════════════════════════

# ── Railway auto-sets PORT, do NOT set it manually ──────────────────
NODE_ENV=production

# ── CORS — add your Vercel URL here after deploying client ──────────
CLIENT_ORIGIN=https://your-app.vercel.app

# ── Internal service URLs (all localhost — same container) ──────────
AUTH_SERVICE_URL=http://localhost:4001
AGENT_SERVICE_URL=http://localhost:4002
INTERVIEW_SERVICE_URL=http://localhost:4003
ROADMAP_SERVICE_URL=http://localhost:4004
BILLING_SERVICE_URL=http://localhost:4005

# ── MongoDB Atlas ───────────────────────────────────────────────────
MONGODB_URI=your_mongodb_atlas_uri

# ── Redis (use Railway Redis add-on or Upstash free tier) ──────────
REDIS_URL=redis://default:your_password@your-redis-host.railway.internal:6379

# ── Firebase Admin SDK ──────────────────────────────────────────────
FIREBASE_PROJECT_ID=swiggy-37641
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-ocsvs@swiggy-37641.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="your_firebase_private_key_with_newlines"

# ── LLM (Groq) ─────────────────────────────────────────────────────
OPENAI_API_KEY=your_groq_api_key_here
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ── Razorpay (Test mode) ───────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ── Session ─────────────────────────────────────────────────────────
SESSION_TTL_SECONDS=604800
