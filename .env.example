# Root-level credentials used by docker-compose.yml
# Copy to .env and fill in real values.

# Firebase (same values for all services)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Razorpay test mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Client Firebase web config goes in client/.env (VITE_FIREBASE_* keys)
